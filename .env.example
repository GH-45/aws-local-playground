##################################################
# Floci (AWS)
##################################################

# ==== Image & Container ===
FLOCI_IMAGE=floci/floci:2.1.0
FLOCI_CONTAINER_NAME=floci
FLOCI_RESTART_POLICY=unless-stopped

# ===== Ports & Network =====
FLOCI_CONTAINER_PORT=4566
# FLOCI_ELASTICACHE_PORTS=6379-6399
# FLOCI_RDS_PORTS=7001-7099

# ==== Environment ====
# Configuración general
FLOCI_HOSTNAME=floci

# Interfaz de usuario
FLOCI_SERVICES_UI_IMAGE=floci/floci-ui:0.5.0
FLOCI_SERVICES_UI_ENABLED=true
FLOCI_SERVICES_UI_PORT=4500

# Almacenamiento
FLOCI_STORAGE_MODE=hybrid
FLOCI_STORAGE_PERSISTENT_PATH=/app/data
FLOCI_DATA_PATH=./floci-data
